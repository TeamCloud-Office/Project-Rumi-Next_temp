# VPS -> Iris: redroid publishes 127.0.0.1:3000 -> container port 3000
IRIS_BASE_URL=http://127.0.0.1:3000
# Iris -> Next: Docker gateway address on this VPS
HOST=172.17.0.1
PORT=2907
IRIS_TIMEOUT_MS=10000
# 등록 신청을 전달받을 운영 채널
DEV_CHANNEL_ID=18375965161587381
# 방장·프로필·대여 만료 확인 주기(ms)
WATCHER_INTERVAL_MS=60000
# eval 명령은 true여도 임의 코드를 실행하지 않고 차단 안내만 표시합니다.
ENABLE_EVAL=false
